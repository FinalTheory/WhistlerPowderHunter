[Unit]
Description=Whistler Powder Hunter forecast generator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=god
Group=god
WorkingDirectory=/home/god/services/whistler
Environment=HOME=/var/lib/whistler
Environment=CODEX_HOME=/var/lib/whistler/codex
Environment=WHISTLER_CODEX_BIN=/home/god/services/whistler/bin/codex
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=OPENAI_API_KEY CODEX_API_KEY CODEX_ACCESS_TOKEN
ExecStart=/home/god/services/whistler/.venv/bin/python -u /home/god/services/whistler/main.py --out /var/lib/whistler/public
Restart=on-failure
RestartSec=30s
UMask=0022
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectHome=tmpfs
BindReadOnlyPaths=/home/god/services/whistler
ProtectSystem=strict
StateDirectory=whistler
StateDirectoryMode=0711
SyslogIdentifier=whistler-powder-hunter

[Install]
WantedBy=multi-user.target
