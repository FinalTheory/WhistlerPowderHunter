[Unit]
Description=Whistler Powder Hunter forecast generator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=whistler
Group=whistler
WorkingDirectory=/opt/whistler/app
Environment=HOME=/var/lib/whistler
Environment=CODEX_HOME=/var/lib/whistler/codex
Environment=WHISTLER_CODEX_BIN=/opt/whistler/bin/codex
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=OPENAI_API_KEY CODEX_API_KEY CODEX_ACCESS_TOKEN
ExecStart=/opt/whistler/venv/bin/python -u /opt/whistler/app/main.py --out /var/lib/whistler/public
Restart=on-failure
RestartSec=30s
UMask=0022
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/whistler
SyslogIdentifier=whistler-powder-hunter

[Install]
WantedBy=multi-user.target
